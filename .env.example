# Copy to .env and export, or set in your shell. Cairn never stores keys in cairn.toml.

# Claude (enables fast/balanced/frontier tiers automatically when no models are configured)
ANTHROPIC_API_KEY=

# Any OpenAI-compatible endpoint
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# CAIRN_OPENAI_MODEL=
# CAIRN_OPENAI_TIER=balanced

# Local model through Ollama (http://localhost:11434)
# CAIRN_OLLAMA_MODEL=llama3.1:8b
# CAIRN_OLLAMA_TIER=fast

# HTTP API keys (comma-separated). Without keys the API only accepts loopback clients.
# CAIRN_API_KEYS=

# Secrets exposed to tools that declare them, e.g. CAIRN_SECRET_GITHUB_TOKEN -> "GITHUB_TOKEN"
# CAIRN_SECRET_GITHUB_TOKEN=

# CAIRN_DATA_DIR=.cairn
# CAIRN_NETWORK_ALLOW=*.wikipedia.org,api.github.com
# CAIRN_POLICY_STRICT=false
# CAIRN_LOG_LEVEL=INFO
# CAIRN_JSON_LOGS=1
